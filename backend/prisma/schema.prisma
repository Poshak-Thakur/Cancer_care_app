// Dost - The cancer care companion
// Shared Prisma Schema (Backend & NGO Web & Mobile Sync)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model alert {
  id                   String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id           String            @db.Uuid
  type                 alert_type_enum
  source_type          String?           @db.VarChar(50)
  source_id            String?           @db.Uuid
  severity             String            @db.VarChar(50)
  status               alert_status_enum @default(OPEN)
  client_event_id      String?           @unique @db.Uuid
  rule_id              String?           @db.VarChar(100)
  rule_version         String?           @db.VarChar(50)
  rule_cooldown_until  DateTime?         @db.Timestamptz(6)
  requested_by_user_id String?           @db.Uuid
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  patient              patient           @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  requested_by         useraccount?      @relation("alert_requested_by", fields: [requested_by_user_id], references: [id], onUpdate: NoAction)
  alertrecipient       alertrecipient[]
  alertupdate          alertupdate[]

  @@index([patient_id, status], map: "idx_alert_patient_status")
  @@index([requested_by_user_id], map: "idx_alert_requested_by")
}

model alertdelivery {
  id                 String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_recipient_id String                @db.Uuid
  channel            delivery_channel_enum
  delivery_status    delivery_status_enum  @default(QUEUED)
  failure_reason     String?
  queued_at          DateTime              @default(now()) @db.Timestamptz(6)
  sent_at            DateTime?             @db.Timestamptz(6)
  delivered_at       DateTime?             @db.Timestamptz(6)
  seen_at            DateTime?             @db.Timestamptz(6)
  failed_at          DateTime?             @db.Timestamptz(6)
  alertrecipient     alertrecipient        @relation(fields: [alert_recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([alert_recipient_id, delivery_status], map: "idx_delivery_status")
}

model alertrecipient {
  id                                                        String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_id                                                  String          @db.Uuid
  recipient_user_id                                         String          @db.Uuid
  acknowledged_at                                           DateTime?       @db.Timestamptz(6)
  response_note                                             String?
  resolution                                                String?         @db.VarChar(255)
  resolver_id                                               String?         @db.Uuid
  alertdelivery                                             alertdelivery[]
  alert                                                     alert           @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  useraccount_alertrecipient_recipient_user_idTouseraccount useraccount     @relation("alertrecipient_recipient_user_idTouseraccount", fields: [recipient_user_id], references: [id], onUpdate: NoAction)
  useraccount_alertrecipient_resolver_idTouseraccount       useraccount?    @relation("alertrecipient_resolver_idTouseraccount", fields: [resolver_id], references: [id], onUpdate: NoAction)

  @@unique([alert_id, recipient_user_id], map: "uq_alert_recipient")
}

model alertupdate {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_id        String      @db.Uuid
  created_by      String      @db.Uuid
  type            String      @db.VarChar(50)
  note            String?
  client_event_id String?     @unique @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  alert           alert       @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  useraccount     useraccount @relation(fields: [created_by], references: [id], onUpdate: NoAction)
}

model auditlogentry {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  actor_id        String?      @db.Uuid
  target_resource String       @db.VarChar(100)
  target_id       String       @db.Uuid
  action          String       @db.VarChar(50)
  payload         Json?
  ip_address      String?      @db.VarChar(45)
  user_agent      String?
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  useraccount     useraccount? @relation(fields: [actor_id], references: [id], onUpdate: NoAction)

  @@index([target_resource, target_id], map: "idx_audit_target")
}

model authotp {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email          String   @db.Citext
  otp_hash       String   @db.VarChar(255)
  attempts_count Int      @default(0)
  expires_at     DateTime @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([email, expires_at], map: "idx_auth_otp_lookup")
}

model careevent {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id            String                 @db.Uuid
  patient_medication_id String?                @db.Uuid
  type                  care_event_type_enum
  schedule_time         DateTime               @db.Timestamptz(6)
  assignee_user_id      String?                @db.Uuid
  reminder_rule         Json?
  completion_status     care_event_status_enum @default(SCHEDULED)
  completed_at          DateTime?              @db.Timestamptz(6)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @db.Timestamptz(6)
  useraccount           useraccount?           @relation(fields: [assignee_user_id], references: [id], onUpdate: NoAction)
  patient               patient                @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patientmedication     patientmedication?     @relation(fields: [patient_medication_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([patient_id, schedule_time, completion_status], map: "idx_care_event_schedule")
}

model caregiverprofile {
  id                     String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                String                      @unique @db.Uuid
  caregiver_type         caregiver_type_enum
  ngo_recognition_status ngo_recognition_status_enum @default(NOT_RECOGNIZED)
  recognized_by          String?                     @db.Uuid
  recognized_at          DateTime?                   @db.Timestamptz(6)
  created_at             DateTime                    @default(now()) @db.Timestamptz(6)

  useraccount            useraccount                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recognized_by_user     useraccount?                @relation("caregiverprofile_recognized_by", fields: [recognized_by], references: [id], onUpdate: NoAction)
}

model caregiverinvite {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id  String           @db.Uuid
  code        String           @unique @db.VarChar(10)
  invite_kind invite_kind_enum @default(CAREGIVER)
  is_used     Boolean          @default(false)
  expires_at  DateTime         @db.Timestamptz(6)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  created_by  String?          @db.Uuid
  patient     patient          @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  creator     useraccount?     @relation("caregiverinvite_creator", fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([code, is_used])
  @@index([patient_id, invite_kind, is_used], map: "idx_invite_patient_kind")
}

// Supports both authenticated and unauthenticated (bootstrap code entry) rate limiting
model patientclaimattempt {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String?      @db.Uuid
  ip_address   String?      @db.VarChar(45)
  attempted_at DateTime     @default(now()) @db.Timestamptz(6)
  useraccount  useraccount? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, attempted_at], map: "idx_claim_attempt_user_time")
  @@index([ip_address, attempted_at], map: "idx_claim_attempt_ip_time")
}

model consentrecord {
  id                                                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id                                        String              @db.Uuid
  grantee_id                                        String              @db.Uuid
  data_scope                                        String              @db.VarChar(100)
  status                                            consent_status_enum @default(GRANTED)
  granted_by                                        String              @db.Uuid
  granted_at                                        DateTime            @default(now()) @db.Timestamptz(6)
  revoked_at                                        DateTime?           @db.Timestamptz(6)
  useraccount_consentrecord_granted_byTouseraccount useraccount         @relation("consentrecord_granted_byTouseraccount", fields: [granted_by], references: [id], onUpdate: NoAction)
  useraccount_consentrecord_grantee_idTouseraccount useraccount         @relation("consentrecord_grantee_idTouseraccount", fields: [grantee_id], references: [id], onUpdate: NoAction)
  patient                                           patient             @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([patient_id, grantee_id, data_scope, status], map: "idx_consent_active")
  @@unique([patient_id, grantee_id, data_scope], map: "uq_consent_one_active_grant", where: raw("((status = 'GRANTED'::consent_status_enum) AND (revoked_at IS NULL))"))
}

model patient {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name            String                 @db.VarChar(255)
  date_of_birth        DateTime               @db.Date
  preferred_language   String                 @default("en") @db.VarChar(10)
  cancer_type          String?                @db.VarChar(255)
  cancer_stage         String?                @db.VarChar(50)
  diagnosis_date       DateTime?              @db.Date
  care_plan_summary    String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  alert                alert[]
  callsession          callsession[]
  careevent            careevent[]
  caregiverinvite      caregiverinvite[]
  chatconversation     chatconversation[]
  consentrecord        consentrecord[]
  medicaldocument      medicaldocument[]
  patientaccountlink   patientaccountlink[]
  patientcaregiverlink patientcaregiverlink[]
  patientcasenote      patientcasenote[]
  patientmedication    patientmedication[]
  prescription         prescription[]
  staffassignment      staffassignment[]
  symptomevent         symptomevent[]
}

model patientaccountlink {
  id                                                     String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                                                String              @db.Uuid
  patient_id                                             String              @db.Uuid
  relationship_type                                      account_link_type
  relationship_label                                     String?             @db.VarChar(100)
  access_scopes                                          Json                @default("[]")
  consent_status                                         consent_status_enum @default(GRANTED)
  granted_by                                             String?             @db.Uuid
  granted_at                                             DateTime            @default(now()) @db.Timestamptz(6)
  revoked_at                                             DateTime?           @db.Timestamptz(6)
  useraccount_patientaccountlink_granted_byTouseraccount useraccount?        @relation("patientaccountlink_granted_byTouseraccount", fields: [granted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient                                                patient             @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  useraccount_patientaccountlink_user_idTouseraccount    useraccount         @relation("patientaccountlink_user_idTouseraccount", fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, patient_id], map: "uq_user_patient_link")
  @@unique([patient_id], map: "uq_one_active_self_per_patient", where: raw("((relationship_type = 'SELF'::account_link_type) AND (consent_status = 'GRANTED'::consent_status_enum) AND (revoked_at IS NULL))"))
  @@index([user_id, patient_id], map: "idx_account_link_lookup")
  @@index([patient_id, consent_status], map: "idx_account_link_patient_consent")
  @@index([user_id, consent_status], map: "idx_account_link_user_consent")
}

model patientcaregiverlink {
  id                 String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id         String                      @db.Uuid
  caregiver_user_id  String                      @db.Uuid
  is_primary         Boolean                     @default(false)
  relationship_label String?                     @db.VarChar(100)
  access_scopes      Json                        @default("[]")
  availability       caregiver_availability_enum @default(AVAILABLE)
  consent_status     consent_status_enum         @default(GRANTED)
  revoked_at         DateTime?                   @db.Timestamptz(6)
  created_at         DateTime                    @default(now()) @db.Timestamptz(6)
  useraccount        useraccount                 @relation(fields: [caregiver_user_id], references: [id], onUpdate: NoAction)
  patient            patient                     @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([patient_id, caregiver_user_id], map: "uq_patient_caregiver")
  @@index([patient_id, caregiver_user_id], map: "idx_caregiver_patient")
  @@index([caregiver_user_id, consent_status], map: "idx_caregiver_link_user_consent")
}

model patientcasenote {
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id String      @db.Uuid
  author_id  String      @db.Uuid
  note       String
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  patient    patient     @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  author     useraccount @relation("casenote_author", fields: [author_id], references: [id], onUpdate: NoAction)

  @@index([patient_id, created_at], map: "idx_case_note_patient")
}

model patientmedication {
  id                                                     String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id                                             String                   @db.Uuid
  name                                                   String                   @db.VarChar(255)
  strength                                               String?                  @db.VarChar(100)
  form                                                   String?                  @db.VarChar(100)
  kind                                                   medication_kind_enum     @default(SCHEDULED)
  instructions                                           String?
  verification_status                                    verification_status_enum @default(PENDING)
  source_prescription_id                                 String?                  @db.Uuid
  entered_by                                             String                   @db.Uuid
  verified_by                                            String?                  @db.Uuid
  verified_at                                            DateTime?                @db.Timestamptz(6)
  created_at                                             DateTime                 @default(now()) @db.Timestamptz(6)
  careevent                                              careevent[]
  useraccount_patientmedication_entered_byTouseraccount  useraccount              @relation("patientmedication_entered_byTouseraccount", fields: [entered_by], references: [id], onUpdate: NoAction)
  patient                                                patient                  @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prescription                                           prescription?            @relation(fields: [source_prescription_id], references: [id], onUpdate: NoAction)
  useraccount_patientmedication_verified_byTouseraccount useraccount?             @relation("patientmedication_verified_byTouseraccount", fields: [verified_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([patient_id, verification_status], map: "idx_medication_patient")
}

model prescription {
  id                     String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id             String                   @db.Uuid
  file_path              String                   @db.VarChar(1024)
  mime_type              String                   @db.VarChar(100)
  file_size_bytes        BigInt
  uploaded_by            String                   @db.Uuid
  uploaded_at            DateTime                 @default(now()) @db.Timestamptz(6)
  patientmedication      patientmedication[]
  patient                patient                  @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  useraccount            useraccount              @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)
  prescriptionextraction prescriptionextraction[]
}

model prescriptionextraction {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  prescription_id  String       @db.Uuid
  extracted_text   String
  raw_payload      Json
  confidence_score Decimal?     @db.Decimal(4, 3)
  processed_at     DateTime     @default(now()) @db.Timestamptz(6)
  prescription     prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model refreshtoken {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String      @db.Uuid
  token_hash  String      @unique @db.VarChar(255)
  revoked     Boolean     @default(false)
  expires_at  DateTime    @db.Timestamptz(6)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  useraccount useraccount @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_token_user")
}

model staffassignment {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id    String          @db.Uuid
  staff_user_id String          @db.Uuid
  role          staff_role_enum
  is_primary    Boolean         @default(false)
  active_from   DateTime        @default(now()) @db.Timestamptz(6)
  active_until  DateTime?       @db.Timestamptz(6)
  status        String          @default("ACTIVE") @db.VarChar(50)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  patient       patient         @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  useraccount   useraccount     @relation(fields: [staff_user_id], references: [id], onUpdate: NoAction)

  @@unique([patient_id, role], map: "uq_primary_staff_per_role", where: raw("((is_primary = true) AND ((status)::text = 'ACTIVE'::text))"))
}

model staffprofile {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String      @unique @db.Uuid
  roles       Json        @default("[]")
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  useraccount useraccount @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model symptomevent {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id         String               @db.Uuid
  recorded_by        String               @db.Uuid
  source             symptom_source_enum
  client_event_id    String               @unique @db.Uuid
  sync_state         String               @default("SYNCED") @db.VarChar(50)
  recorded_at        DateTime             @default(now()) @db.Timestamptz(6)
  form_version_id    String?              @db.Uuid
  patient            patient              @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  useraccount        useraccount          @relation(fields: [recorded_by], references: [id], onUpdate: NoAction)
  symptomobservation symptomobservation[]
  form_version       checkinformversion?  @relation(fields: [form_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  checkinanswer      checkinanswer[]

  @@index([patient_id, recorded_at(sort: Desc)], map: "idx_symptom_event_patient")
  @@index([form_version_id], map: "idx_symptom_event_form_version")
}

model symptomobservation {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  symptom_event_id String       @db.Uuid
  observation_type String       @db.VarChar(50)
  severity         Int?
  numeric_value    Decimal?     @db.Decimal(6, 2)
  unit             String?      @db.VarChar(20)
  note             String?
  symptomevent     symptomevent @relation(fields: [symptom_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([symptom_event_id], map: "idx_symptom_obs_parent")
}

model useraccount {
  id                                                            String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  // Nullable so code-invited patients ("I have a code") can activate immediately
  // without an email/OTP screen and attach/verify their email later from Profile.
  email                                                         String?                @unique @db.Citext
  phone_number                                                  String?                @db.VarChar(32)
  preferred_language                                            String                 @default("en") @db.VarChar(10)
  status                                                        String                 @default("ACTIVE") @db.VarChar(50)
  fcm_token                                                     String?                @db.VarChar(255)
  full_name                                                     String?                @db.VarChar(255)
  date_of_birth                                                 DateTime?              @db.Date
  avatar_url                                                    String?                @db.VarChar(1024)
  created_at                                                    DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                                    DateTime               @default(now()) @db.Timestamptz(6)
  alertrecipient_alertrecipient_recipient_user_idTouseraccount  alertrecipient[]       @relation("alertrecipient_recipient_user_idTouseraccount")
  alertrecipient_alertrecipient_resolver_idTouseraccount        alertrecipient[]       @relation("alertrecipient_resolver_idTouseraccount")
  alertupdate                                                   alertupdate[]
  alert_requested                                               alert[]                @relation("alert_requested_by")
  caregiverinvite_created                                       caregiverinvite[]      @relation("caregiverinvite_creator")
  patientcasenote_authored                                      patientcasenote[]      @relation("casenote_author")
  communityreport_reported                                      communityreport[]      @relation("report_reporter")
  communityreport_reviewed                                      communityreport[]      @relation("report_reviewer")
  auditlogentry                                                 auditlogentry[]
  callsession_caller                                            callsession[]          @relation("call_caller")
  callsession_receiver                                          callsession[]          @relation("call_receiver")
  careevent                                                     careevent[]
  caregiverprofile                                              caregiverprofile?
  recognized_caregiver_profiles                                 caregiverprofile[]     @relation("caregiverprofile_recognized_by")
  chat_as_participant_one                                       chatconversation[]     @relation("chat_participant_one")
  chat_as_participant_two                                       chatconversation[]     @relation("chat_participant_two")
  chatmessage_sender                                            chatmessage[]
  communitypost_author                                          communitypost[]        @relation("post_author")
  communitypost_moderator                                       communitypost[]        @relation("post_moderator")
  consentrecord_consentrecord_granted_byTouseraccount           consentrecord[]        @relation("consentrecord_granted_byTouseraccount")
  consentrecord_consentrecord_grantee_idTouseraccount           consentrecord[]        @relation("consentrecord_grantee_idTouseraccount")
  medicaldocument_uploader                                      medicaldocument[]      @relation("doc_uploader")
  medicaldocument_verified                                      medicaldocument[]      @relation("doc_verifier")
  checkinform_created                                           checkinform[]          @relation("checkinform_creator")
  checkinformversion_created                                    checkinformversion[]   @relation("checkinformversion_creator")
  checkinformversion_published                                  checkinformversion[]   @relation("checkinformversion_publisher")
  ngoauthority                                                  ngoauthority?
  patientclaimattempt                                           patientclaimattempt[]
  patientaccountlink_patientaccountlink_granted_byTouseraccount patientaccountlink[]   @relation("patientaccountlink_granted_byTouseraccount")
  patientaccountlink_patientaccountlink_user_idTouseraccount    patientaccountlink[]   @relation("patientaccountlink_user_idTouseraccount")
  patientcaregiverlink                                          patientcaregiverlink[]
  patientmedication_patientmedication_entered_byTouseraccount   patientmedication[]    @relation("patientmedication_entered_byTouseraccount")
  patientmedication_patientmedication_verified_byTouseraccount  patientmedication[]    @relation("patientmedication_verified_byTouseraccount")
  prescription                                                  prescription[]
  refreshtoken                                                  refreshtoken[]
  staffassignment                                               staffassignment[]
  staffprofile                                                  staffprofile?
  symptomevent                                                  symptomevent[]
  postlike                                                      postlike[]
  postcomment                                                   postcomment[]
  pollvote                                                      pollvote[]
}

model communitypost {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  author_id          String               @db.Uuid
  post_type          post_type_enum       @default(TEXT)
  content            String
  media_urls         String[]
  video_duration     Int?
  visibility         post_visibility_enum @default(PUBLIC)
  status             post_status_enum     @default(PENDING)
  moderator_feedback String?
  moderator_id       String?              @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  author             useraccount          @relation("post_author", fields: [author_id], references: [id], onDelete: Cascade)
  moderator          useraccount?         @relation("post_moderator", fields: [moderator_id], references: [id])
  postlike           postlike[]
  postcomment        postcomment[]
  polloption         polloption[]
  pollvote           pollvote[]
  communityreport    communityreport[]

  @@index([status, visibility], map: "idx_post_moderation")
}

model communityreport {
  id             String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  post_id        String                       @db.Uuid
  reporter_id    String                       @db.Uuid
  reason         String                       @db.VarChar(1000)
  status         community_report_status_enum @default(OPEN)
  created_at     DateTime                     @default(now()) @db.Timestamptz(6)
  reviewed_by    String?                      @db.Uuid
  reviewed_at    DateTime?                    @db.Timestamptz(6)
  moderator_note String?
  post           communitypost                @relation(fields: [post_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reporter       useraccount                  @relation("report_reporter", fields: [reporter_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewer       useraccount?                 @relation("report_reviewer", fields: [reviewed_by], references: [id], onUpdate: NoAction)

  @@unique([post_id, reporter_id], map: "uq_open_report_per_user_post", where: raw("(status = 'OPEN'::community_report_status_enum)"))
  @@index([status, created_at], map: "idx_report_status")
  @@index([post_id], map: "idx_report_post")
}

model postlike {
  id         String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  post_id    String        @db.Uuid
  user_id    String        @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  post       communitypost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       useraccount   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
}

model postcomment {
  id         String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  post_id    String        @db.Uuid
  user_id    String        @db.Uuid
  content    String
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  post       communitypost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       useraccount   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model polloption {
  id       String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  post_id  String        @db.Uuid
  option   String        @db.VarChar(255)
  post     communitypost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  pollvote pollvote[]
}

model pollvote {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  polloption_id String        @db.Uuid
  post_id       String        @db.Uuid
  user_id       String        @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  option        polloption    @relation(fields: [polloption_id], references: [id], onDelete: Cascade)
  post          communitypost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user          useraccount   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([polloption_id, user_id])
  @@unique([post_id, user_id], map: "uq_pollvote_post_user")
}

model chatconversation {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id         String?       @db.Uuid
  participant_one_id String        @db.Uuid
  participant_two_id String        @db.Uuid
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  participant_one    useraccount   @relation("chat_participant_one", fields: [participant_one_id], references: [id])
  participant_two    useraccount   @relation("chat_participant_two", fields: [participant_two_id], references: [id])
  patient            patient?      @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  messages           chatmessage[]

  @@index([patient_id], map: "idx_chat_patient")
  @@index([participant_one_id], map: "idx_chat_participant_one")
  @@index([participant_two_id], map: "idx_chat_participant_two")
  @@index([participant_one_id, participant_two_id, patient_id], map: "idx_chat_pair_patient")
  @@index([participant_two_id, participant_one_id, patient_id], map: "idx_chat_pair_patient_rev")
  @@unique([participant_one_id, participant_two_id, patient_id], map: "uq_chat_pair_patient", where: raw("(patient_id IS NOT NULL)"))
  @@unique([participant_one_id, participant_two_id], map: "uq_chat_pair_no_patient", where: raw("(patient_id IS NULL)"))
}

model chatmessage {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversation_id String            @db.Uuid
  sender_id       String            @db.Uuid
  message_type    message_type_enum @default(TEXT)
  content         String?
  media_url       String?           @db.VarChar(1024)
  is_read         Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  conversation    chatconversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender          useraccount       @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at], map: "idx_chat_history")
  @@index([conversation_id, is_read], map: "idx_chat_unread")
}

model callsession {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  caller_id     String           @db.Uuid
  receiver_id   String           @db.Uuid
  status        call_status_enum @default(SCHEDULED)
  provider_room String?          @db.VarChar(255)
  scheduled_for DateTime?        @db.Timestamptz(6)
  started_at    DateTime?        @db.Timestamptz(6)
  ended_at      DateTime?        @db.Timestamptz(6)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  call_type     call_type_enum   @default(VIDEO)
  patient_id    String?          @db.Uuid
  caller        useraccount      @relation("call_caller", fields: [caller_id], references: [id], onDelete: Cascade)
  patient       patient?         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  receiver      useraccount      @relation("call_receiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@index([caller_id, receiver_id], map: "idx_call_participants")
}

model medicaldocument {
  id                  String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patient_id          String                   @db.Uuid
  document_type       document_type_enum       @default(OTHER)
  title               String                   @db.VarChar(255)
  file_path           String                   @db.VarChar(1024)
  mime_type           String                   @db.VarChar(100)
  file_size_bytes     BigInt
  extracted_text      String?
  raw_ocr_payload     Json?
  verification_status verification_status_enum @default(PENDING)
  is_private          Boolean                  @default(true)
  uploaded_by         String                   @db.Uuid
  uploaded_at         DateTime                 @default(now()) @db.Timestamptz(6)
  verified_by         String?                  @db.Uuid
  verified_at         DateTime?                @db.Timestamptz(6)
  patient             patient                  @relation(fields: [patient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  uploader            useraccount              @relation("doc_uploader", fields: [uploaded_by], references: [id], onDelete: NoAction)
  verifier            useraccount?             @relation("doc_verifier", fields: [verified_by], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([patient_id, document_type], map: "idx_medical_doc_patient")
  @@index([verified_by], map: "idx_medical_doc_verified_by")
}

model checkinform {
  id         String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug       String               @unique @db.VarChar(100)
  title      String               @db.VarChar(255)
  created_by String?              @db.Uuid
  created_at DateTime             @default(now()) @db.Timestamptz(6)
  updated_at DateTime             @default(now()) @db.Timestamptz(6)
  creator    useraccount?         @relation("checkinform_creator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  versions   checkinformversion[]
}

model checkinformversion {
  id             String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  form_id        String                      @db.Uuid
  version_number Int
  status         checkin_version_status_enum @default(DRAFT)
  created_by     String?                     @db.Uuid
  published_by   String?                     @db.Uuid
  published_at   DateTime?                   @db.Timestamptz(6)
  archived_at    DateTime?                   @db.Timestamptz(6)
  created_at     DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                    @default(now()) @db.Timestamptz(6)
  form           checkinform                 @relation(fields: [form_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator        useraccount?                @relation("checkinformversion_creator", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  publisher      useraccount?                @relation("checkinformversion_publisher", fields: [published_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fields         checkinfield[]
  symptomevent   symptomevent[]

  @@unique([form_id, version_number], map: "uq_checkin_form_version_number")
  @@unique([form_id], map: "uq_checkin_one_published_version", where: raw("(status = 'PUBLISHED'::checkin_version_status_enum)"))
  @@unique([form_id], map: "uq_checkin_one_draft_version", where: raw("(status = 'DRAFT'::checkin_version_status_enum)"))
  @@index([form_id, status], map: "idx_checkin_version_form_status")
}

model checkinfield {
  id                String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  version_id        String               @db.Uuid
  field_key         String               @db.VarChar(100)
  label             String               @db.VarChar(255)
  help_text         String?
  field_type        checkin_field_type_enum
  is_required       Boolean              @default(false)
  display_order     Int
  validation_config Json?
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  version           checkinformversion   @relation(fields: [version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  options           checkinfieldoption[]
  answers           checkinanswer[]

  @@unique([version_id, field_key], map: "uq_checkin_field_key_per_version")
  @@index([version_id, display_order], map: "idx_checkin_field_order")
}

model checkinfieldoption {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  field_id      String          @db.Uuid
  option_value  String          @db.VarChar(100)
  label         String          @db.VarChar(255)
  display_order Int
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  field         checkinfield    @relation(fields: [field_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  answers       checkinanswer[]

  @@unique([field_id, option_value], map: "uq_checkin_option_value_per_field")
  @@index([field_id, display_order], map: "idx_checkin_option_order")
}

model checkinanswer {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  symptom_event_id String              @db.Uuid
  field_id         String              @db.Uuid
  option_id        String?             @db.Uuid
  value_text       String?
  value_number     Decimal?            @db.Decimal(12, 4)
  value_boolean    Boolean?
  value_json       Json?
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  symptomevent     symptomevent        @relation(fields: [symptom_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field            checkinfield        @relation(fields: [field_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  option           checkinfieldoption? @relation(fields: [option_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([symptom_event_id, field_id], map: "uq_checkin_answer_event_field")
  @@index([field_id], map: "idx_checkin_answer_field")
}

model ngoauthority {
  key         String      @id @default("CENTRAL") @db.VarChar(20)
  user_id     String      @unique @db.Uuid
  assigned_at DateTime    @default(now()) @db.Timestamptz(6)
  useraccount useraccount @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

